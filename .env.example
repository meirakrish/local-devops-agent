# Ollama server URL (default local install)
OLLAMA_URL=http://localhost:11434
# Local model used for triage/investigation
MODEL=qwen2.5:7b-instruct
# Path to kubeconfig; leave empty to use ~/.kube/config or $KUBECONFIG
KUBECONFIG=
# Max tool calls the agent may make per investigated problem
MAX_STEPS_PER_PROBLEM=6
# Pods restarting at least this many times are flagged
RESTART_THRESHOLD=5
# Only include warning events newer than this many minutes
EVENT_WINDOW_MINUTES=60
# Max problems the LLM investigates per run
MAX_PROBLEMS=5
# Ollama context window in tokens (Ollama's default is small and silently truncates)
NUM_CTX=16384
# Tool outputs longer than this many characters are truncated before reaching the LLM
TOOL_OUTPUT_MAX_CHARS=4000
